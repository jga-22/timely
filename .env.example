# Copy to .env and uncomment what you need. With nothing set, Timely saves to this browser (localStorage).

# Storage mode: local (default) | supabase
# NUXT_PUBLIC_STORAGE=local

# Supabase (storage=supabase). Use the URL and anon key from `supabase status` (local) or the project API settings.
# Anonymous sign-ins must be enabled in the Supabase project (Authentication, Sign In / Providers) until the login lands.
# NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
